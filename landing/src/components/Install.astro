---
// Install.astro — the two commands, what the second one actually does, and the
// requirement line. All of it from README "Quick start" and docs/INSTALLATION.md.
import { REPO_URL } from '../consts';

const commands = [
  'cargo build --release',
  './target/release/shade install',
];

const requirements = [
  'Apple Silicon',
  'macOS',
  'APFS',
  'Rust 1.93+',
  'Git',
  'uv >= 0.11.16 for Python repositories',
];

const effects = [
  'Copies the same binary to ~/Library/Application Support/Shade/bin/shade.',
  'Writes a private LaunchAgent plist for the com.shade.daemon label.',
  'Bootstraps it in your GUI launchd domain.',
];
---

<section class="install section-pad" id="install" aria-labelledby="install-title">
  <div class="container">
    <div class="lbl-row" data-reveal>
      <span class="lbl">[ Install ]</span>
      <span class="lbl">[ 2 commands ]</span>
    </div>

    <div class="install-head" data-reveal>
      <h2 class="t-section" id="install-title">
        Build it, then let it <span class="blue">install itself.</span>
      </h2>
      <p class="t-body-lg install-lede">
        One binary serves both the CLI and the daemon, so there is nothing else to place on your
        machine.
      </p>
    </div>

    <div class="fig install-fig" data-reveal data-reveal-delay="100">
      <span class="cm tl"></span><span class="cm tr"></span><span class="cm bl"></span><span class="cm br"></span>

      <div class="install-body">
        <div class="install-cmds">
          {commands.map((command) => (
            <div class="cmd">
              <code><span class="cmd-sigil">$ </span>{command}</code>
              <button
                class="cmd-copy mono"
                type="button"
                data-copy={command}
                aria-label={`Copy: ${command}`}
              >copy</button>
            </div>
          ))}

          <p class="req">
            <span class="req-label lbl">Requires</span>
            <span class="req-items">
              {requirements.map((requirement) => (
                <span class="req-item mono">{requirement}</span>
              ))}
            </span>
          </p>
        </div>

        <div class="install-effects">
          <h3 class="effects-title mono">shade install</h3>
          <ul role="list">
            {effects.map((effect) => <li>{effect}</li>)}
          </ul>
          <a href={REPO_URL} rel="noreferrer" class="btn-primary install-cta">
            View on GitHub <span class="arrow">&#8599;</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .install { border-top: 1px solid var(--border); background: var(--bg-soft); }

  .install-head { max-width: 58ch; margin-bottom: 40px; }
  .install-lede { margin-top: 18px; color: var(--body); max-width: 54ch; }

  .install-fig { padding: 34px; }

  .install-body {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(28px, 4vw, 54px);
    align-items: start;
  }

  .install-cmds { display: flex; flex-direction: column; gap: 12px; }
  .install-cmds .cmd { background: #fff; }

  .req {
    margin-top: 14px;
    padding-top: 18px;
    border-top: 1px solid var(--blue-line);
  }
  .req-label { display: block; margin-bottom: 12px; color: var(--accent-strong); }
  .req-items { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .req-item {
    border: 1px solid var(--chip-border);
    background: var(--chip);
    padding: 6px 9px;
    font-size: 11.5px;
    color: var(--ink);
  }

  .install-effects {
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid var(--blue-line);
    padding: 24px 24px 26px;
  }
  .effects-title {
    font-size: 12.5px;
    letter-spacing: 0.04em;
    color: var(--accent-strong);
    margin-bottom: 14px;
  }
  .install-effects ul { list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .install-effects li {
    position: relative;
    padding-left: 18px;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--body);
  }
  .install-effects li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 7px;
    width: 7px;
    height: 7px;
    background: var(--accent);
  }
  .install-cta { margin-top: 22px; }

  @media (max-width: 880px) {
    .install-body { grid-template-columns: 1fr; }
    .install-fig { padding: 26px 20px; }
  }
  @media (max-width: 560px) {
    .install-cmds .cmd code { font-size: 11.5px; }
  }
</style>
