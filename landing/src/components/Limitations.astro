---
// Limitations.astro — the constraints stated up front, in the repository's own
// words (README "Status" and "Platform constraint", docs/SECURITY.md).
import { repoPath } from '../consts';

const limits = [
  {
    tag: 'platform',
    title: 'Apple Silicon, macOS and APFS only',
    body:
      'There is no Linux, CI, Intel Mac or non-APFS support yet, and unsupported targets fail closed. Production materialization requires a successful APFS clone syscall on the same filesystem. A failure returns COW_UNAVAILABLE, and there is no byte-copy fallback.',
  },
  {
    tag: 'distribution',
    title: 'Not signed and not notarized',
    body: 'Integrity is verified with SHA-256 checksums only.',
  },
  {
    tag: 'isolation',
    title: 'A single-user daemon, not a same-UID sandbox',
    body:
      'The daemon runs as your login user. A linked worktree exposes a writable Git object database, so the secret clean filter is an accidental-commit guardrail rather than a boundary against a malicious local process.',
    link: { label: 'docs/SECURITY.md', href: repoPath('docs/SECURITY.md') },
  },
  {
    tag: 'storage',
    title: 'Schema version 1, with no migrations',
    body: 'A database written by a different schema version is rejected rather than upgraded.',
  },
  {
    tag: 'repositories',
    title: 'V1 rejects several repository shapes',
    body:
      'Submodules, Git LFS, custom Git filters, tracked .env files, missing dependency locks, source builds and executable package-manager configuration are all rejected. Shade never installs a runtime or toolchain.',
  },
];
---

<section class="limits section-pad" id="limitations" aria-labelledby="limits-title">
  <div class="container">
    <div class="lbl-row" data-reveal>
      <span class="lbl">[ Honest limitations ]</span>
      <span class="lbl">[ 5 ]</span>
    </div>

    <div class="limits-layout">
      <div class="limits-head" data-reveal>
        <h2 class="t-section" id="limits-title">
          What Shade <span class="blue">will not do yet.</span>
        </h2>
        <p class="t-body limits-lede">
          Version 0.1.0 is a release candidate. These constraints are stated up front because finding
          them at integration time is worse than reading them here.
        </p>
      </div>

      <ul class="limits-list" role="list">
        {limits.map((limit, i) => (
          <li class="limit" data-reveal data-reveal-delay={i * 60}>
            <span class="lm-tag mono">{limit.tag}</span>
            <div class="lm-copy">
              <h3 class="lm-title">{limit.title}</h3>
              <p class="lm-body">
                {limit.body}
                {limit.link && (
                  <>
                    {' '}
                    <a href={limit.link.href} rel="noreferrer"><code class="mono">{limit.link.label}</code></a>
                    {' states the precise threat model.'}
                  </>
                )}
              </p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .limits { border-top: 1px solid var(--border); }

  .limits-layout {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .limits-head { position: sticky; top: 96px; }
  .limits-lede { margin-top: 18px; color: var(--body); max-width: 40ch; }

  .limits-list { list-style: none; }

  .limit {
    display: grid;
    grid-template-columns: 118px 1fr;
    gap: 20px;
    padding: 22px 0 24px;
    border-top: 1px solid var(--border);
  }
  .limit:first-child { border-top: 0; padding-top: 0; }

  .lm-tag {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint-2);
    padding-top: 4px;
  }

  .lm-title { font-size: 1.05rem; font-weight: 600; letter-spacing: -0.015em; line-height: 1.3; }
  .lm-body {
    margin-top: 10px;
    color: var(--body);
    font-size: 14.5px;
    line-height: 1.62;
    max-width: 62ch;
  }
  .lm-body a { color: var(--body); text-decoration: underline; text-underline-offset: 2px; }
  .lm-body a:hover { color: var(--accent); }
  .lm-body a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  @media (max-width: 900px) {
    .limits-layout { grid-template-columns: 1fr; }
    .limits-head { position: static; }
    .limits-lede { max-width: 58ch; }
  }
  @media (max-width: 560px) {
    .limit { grid-template-columns: 1fr; gap: 8px; }
    .lm-tag { padding-top: 0; }
  }
</style>
