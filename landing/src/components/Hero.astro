---
// Hero.astro — light copy over a dot-grid backdrop (top 2/3) with a full-bleed
// dark Paper <Dithering> "warp" band underneath (bottom 1/3).
import HeroDither from './hero/HeroDither.tsx';
import { REPO_URL, VERSION, LICENSE } from '../consts';

const INSTALL_COMMAND = 'cargo build --release && ./target/release/shade install';
---

<section class="hero" id="top">
  <div class="hero-copy">
    <div class="dot-grid" aria-hidden="true"></div>
    <div class="glow" aria-hidden="true"></div>

    <div class="hero-content">
      <span class="pill mono hero-pill" data-reveal data-reveal-delay="0">
        <span class="dot"></span>APPLE SILICON &middot; macOS &middot; APFS
      </span>

      <h1 class="hero-h1" data-reveal data-reveal-delay="80">
        20 agents. 20 working trees. <br class="h1-br" />Zero extra <span class="blue">bytes.</span>
      </h1>

      <p class="t-body-lg hero-sub" data-reveal data-reveal-delay="160">
        Shade turns a Git repository into many isolated, instantly created coding
        workspaces for AI agents on macOS.
      </p>

      <div class="hero-actions" data-reveal data-reveal-delay="240">
        <div class="cmd hero-cmd">
          <code><span class="cmd-sigil">$ </span>{INSTALL_COMMAND}</code>
          <button
            class="cmd-copy mono"
            type="button"
            data-copy={INSTALL_COMMAND}
            aria-label="Copy the install command"
          >copy</button>
        </div>
        <a href={REPO_URL} rel="noreferrer" class="btn-ghost hero-repo">
          View on GitHub <span class="arrow">&#8599;</span>
        </a>
      </div>

      <div class="hero-trust" data-reveal data-reveal-delay="320">
        <span class="tl mono">v{VERSION}</span>
        <span class="tsep"></span>
        <span class="tl mono">{LICENSE}</span>
      </div>
    </div>
  </div>

  <div class="hero-visual" aria-hidden="true">
    <div class="shader">
      <HeroDither client:only="react" />
    </div>
  </div>
</section>

<style>
  /* light copy 2/3 · dark warp band 1/3 */
  .hero {
    min-height: 90vh;
    display: grid;
    grid-template-rows: 2fr 1fr;
    /* minmax(0, 1fr) keeps a long command from widening the whole hero. */
    grid-template-columns: minmax(0, 1fr);
    background: var(--bg);
  }

  .hero-copy {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    text-align: center;
    padding: clamp(32px, 5vh, 72px) clamp(24px, 5vw, 48px);
    overflow: hidden;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: min(1000px, 100%);
  }

  .hero-h1 {
    margin-top: 24px;
    font-size: clamp(2.2rem, 4.6vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .hero-sub {
    margin-top: 20px;
    color: var(--body);
    max-width: 54ch;
  }

  .hero-actions {
    margin-top: 30px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    width: 100%;
  }

  .hero-cmd { min-width: 0; max-width: 100%; background: #fff; }
  .hero-cmd code { font-size: 12.5px; }
  .hero-repo { flex: none; }

  .hero-trust {
    margin-top: 32px;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    border-top: 1px solid var(--border);
    padding-top: 16px;
  }
  .hero-trust .tl {
    font-size: 11px;
    letter-spacing: .07em;
    text-transform: uppercase;
    color: var(--faint-2);
  }
  .hero-trust .tsep { width: 1px; height: 12px; background: var(--border-strong); }

  .hero-visual {
    position: relative;
    overflow: hidden;
    background: #0a0f1a;
    min-height: 220px;
  }
  .hero-visual .shader { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .hero-visual :global(canvas) { display: block; }

  @media (max-width: 920px) {
    .hero { min-height: 84vh; }
    .hero-h1 { font-size: clamp(1.85rem, 7.2vw, 2.7rem); }
    .hero-visual { min-height: 190px; }
  }

  /* Below this width the forced break makes the first line too long to fit. */
  @media (max-width: 680px) {
    .h1-br { display: none; }
  }

  @media (max-width: 560px) {
    .hero-actions { flex-direction: column; align-items: stretch; }
    .hero-cmd code { font-size: 11px; padding-inline: 12px; }
    .hero-repo { justify-content: center; }
  }
</style>
