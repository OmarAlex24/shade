---
// CloneStack — the isometric answer to "where do twenty working trees come from".
//
//   wide platform  → the dependency layer, shared across workspaces by fingerprint
//   solid slab     → the immutable base, one per resolved Git commit
//   fan of planes  → ws-01 .. ws-20, APFS clones whose private growth stays at 0 B
//   hairline spine → the SQLite journal, written before any side effect
//
// The three authorities in HowItWorks.astro drive this through a `cs-active-N`
// class on the container: 0 = SQLite (spine), 1 = Git (base), 2 = APFS (planes).
import { project } from '../../scripts/iso';

const O = { ox: 215, oy: 448, scale: 0.78 } as const;

const RAIL_X = 395;
const LABEL_X = 406;
const VALUE_X = 462;

const P = (x: number, y: number, z: number): [number, number] => project(x, y, z, O);
const r2 = (n: number): number => Math.round(n * 100) / 100;
const toStr = (a: Array<[number, number]>): string =>
  a.map(([x, y]) => `${r2(x)},${r2(y)}`).join(' ');

interface Slab {
  top: string;
  left: string;
  right: string;
  center: [number, number];
  anchor: [number, number];
}

/** Axis-aligned square slab centred on the vertical axis. */
function slab(half: number, z: number, height: number): Slab {
  const a = -half;
  const b = half;
  const t = z + height;
  return {
    top: toStr([P(a, a, t), P(b, a, t), P(b, b, t), P(a, b, t)]),
    right: toStr([P(b, a, z), P(b, b, z), P(b, b, t), P(b, a, t)]),
    left: toStr([P(a, b, z), P(b, b, z), P(b, b, t), P(a, b, t)]),
    center: P(0, 0, t),
    anchor: P(half, -half * 0.9, t),
  };
}

const PLANE_COUNT = 20;
const PLANE_HALF = 88;
const PLANE_STEP = 8.5;
const PLANE_BASE_Z = 70;

const deps = slab(115, 0, 16);
const base = slab(PLANE_HALF, 26, 28);
const planes = Array.from({ length: PLANE_COUNT }, (_, i) =>
  slab(PLANE_HALF, PLANE_BASE_Z + i * PLANE_STEP, 2.5),
);

/** Six sampled planes carry a leader line so the ledger stays readable. */
const SAMPLED = [0, 4, 8, 12, 16, 19];
const rows = SAMPLED.map((i) => ({
  id: `ws-${String(i + 1).padStart(2, '0')}`,
  y: planes[i].anchor[1],
  x: planes[i].anchor[0],
}));

/** Journal spine: one tick per workspace, written before the clone lands. */
const SPINE_X = 30;
const ticks = planes.map((plane) => plane.anchor[1]);
const spineTop = ticks[ticks.length - 1] - 14;
const spineBottom = ticks[0] + 67;

const flowPath = `M ${r2(base.center[0])} ${r2(base.center[1])} L ${r2(planes[PLANE_COUNT - 1].center[0])} ${r2(planes[PLANE_COUNT - 1].center[1])}`;
---

<div class="fig clone-stack js-graph">
  <span class="cm tl"></span><span class="cm tr"></span><span class="cm bl"></span><span class="cm br"></span>
  <div class="lbl fig-label">[ Materialization ]</div>

  <svg
    viewBox="0 0 580 560"
    width="100%"
    role="img"
    aria-label="Isometric diagram: a shared dependency platform, one immutable base slab above it, and a fan of twenty workspace clone planes whose private growth is zero bytes, with the SQLite journal drawn as a ticked spine alongside."
  >
    <defs>
      <linearGradient id="cs-core" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#3b82f6" />
        <stop offset="100%" stop-color="#2563eb" />
      </linearGradient>
    </defs>

    <!-- shared dependency platform -->
    <g class="cs-deps">
      <polygon class="f-left" points={deps.left} />
      <polygon class="f-right" points={deps.right} />
      <polygon class="f-top" points={deps.top} />
    </g>

    <!-- immutable base -->
    <g class="cs-base">
      <polygon class="f-left" points={base.left} />
      <polygon class="f-right" points={base.right} />
      <polygon class="f-top" points={base.top} />
      <polygon class="hot hot-left" points={base.left} />
      <polygon class="hot hot-right" points={base.right} />
      <polygon class="hot hot-top" points={base.top} />
    </g>

    <!-- twenty clone planes -->
    <g class="cs-planes">
      {planes.map((plane) => (
        <g class="cs-plane">
          <polygon class="p-left" points={plane.left} />
          <polygon class="p-right" points={plane.right} />
          <polygon class="p-top" points={plane.top} />
        </g>
      ))}
    </g>

    <!-- clone flow along the stack axis (APFS) -->
    <g class="cs-flow">
      <path class="g-flow" d={flowPath} />
    </g>

    <!-- SQLite journal spine -->
    <g class="cs-spine">
      <line class="spine" x1={SPINE_X} y1={r2(spineTop)} x2={SPINE_X} y2={r2(spineBottom)} />
      {ticks.map((y) => (
        <line class="tick" x1={SPINE_X} y1={r2(y)} x2={SPINE_X + 8} y2={r2(y)} />
      ))}
      <text class="ill-tm spine-label" x={SPINE_X - 8} y={r2(spineTop) - 12}>journal</text>
      <g class="cs-spine-pulse">
        <circle class="g-pulse" cx={SPINE_X} cy={r2(spineBottom)} r="9" />
        <circle class="g-pulse" cx={SPINE_X} cy={r2(spineBottom)} r="15" style="animation-delay:.9s" />
        <circle class="spine-seed" cx={SPINE_X} cy={r2(spineBottom)} r="3" />
      </g>
    </g>

    <!-- leaders: dependency platform + immutable base -->
    <g class="cs-lead cs-lead-deps">
      <line class="leader" x1={r2(deps.anchor[0])} y1={r2(deps.anchor[1])} x2={RAIL_X} y2={r2(deps.anchor[1])} />
      <circle class="leader-dot" cx={RAIL_X} cy={r2(deps.anchor[1])} r="2.4" />
      <text class="ill-tm lead-label" x={LABEL_X} y={r2(deps.anchor[1]) + 3.5}>shared by fingerprint</text>
    </g>

    <g class="cs-lead cs-lead-base">
      <line class="leader" x1={r2(base.anchor[0])} y1={r2(base.anchor[1])} x2={RAIL_X} y2={r2(base.anchor[1])} />
      <circle class="leader-dot" cx={RAIL_X} cy={r2(base.anchor[1])} r="2.4" />
      <text class="ill-tm lead-label" x={LABEL_X} y={r2(base.anchor[1]) + 3.5}>{'base · <commit>'}</text>
    </g>

    <!-- leaders: sampled workspace planes, every one ending in 0 B -->
    <g class="cs-lead cs-lead-planes">
      {rows.map((row) => (
        <g>
          <line class="leader" x1={r2(row.x)} y1={r2(row.y)} x2={RAIL_X} y2={r2(row.y)} />
          <circle class="leader-dot" cx={RAIL_X} cy={r2(row.y)} r="2.4" />
          <text class="ill-tm lead-label" x={LABEL_X} y={r2(row.y) + 3.5}>{row.id}</text>
          <text class="cs-val" x={VALUE_X} y={r2(row.y) + 3.5}>0 B</text>
        </g>
      ))}
    </g>
  </svg>
</div>

<style>
  .clone-stack {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18px 14px;
    min-height: 420px;
  }

  /* ── slab faces ─────────────────────────────────────────── */
  .cs-deps polygon,
  .cs-base polygon {
    stroke: #2563eb;
    stroke-width: 1.2;
    stroke-linejoin: round;
  }
  .f-top { fill: #ffffff; }
  .f-left { fill: #d7e4ff; }
  .f-right { fill: #bcd2fb; }

  .cs-deps polygon { stroke: #8fb3f6; }

  /* Git highlight overlay on the immutable base */
  .hot { opacity: 0; stroke: #1e40af; transition: opacity .5s cubic-bezier(.16, 1, .3, 1); }
  .hot-top { fill: url(#cs-core); }
  .hot-left { fill: #1d4ed8; }
  .hot-right { fill: #1b3fb0; }

  /* ── clone planes ───────────────────────────────────────── */
  .cs-plane polygon {
    stroke: #6f9df4;
    stroke-width: 0.9;
    stroke-linejoin: round;
    transition: stroke .45s ease, fill .45s ease;
  }
  .p-top { fill: rgba(255, 255, 255, 0.72); }
  .p-left { fill: rgba(215, 228, 255, 0.75); }
  .p-right { fill: rgba(188, 210, 251, 0.8); }

  /* ── journal spine ──────────────────────────────────────── */
  .spine { stroke: var(--blue-line); stroke-width: 1.1; transition: stroke .4s ease; }
  .tick { stroke: var(--blue-line); stroke-width: 1.1; transition: stroke .4s ease; }
  .spine-seed { fill: var(--blue-line); transition: fill .4s ease; }
  .spine-label { letter-spacing: .1em; }
  .cs-spine-pulse { opacity: 0; transition: opacity .4s ease; }

  /* ── leaders ────────────────────────────────────────────── */
  .leader { stroke: #bdd0fb; stroke-width: 1.1; }
  .leader-dot { fill: #2563eb; }
  .lead-label { font-size: 10px; }
  .cs-val {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .cs-lead { opacity: 0.5; transition: opacity .45s ease; }
  .cs-lead-deps { opacity: 0.9; }

  /* ── clone flow ─────────────────────────────────────────── */
  .cs-flow { opacity: 0; transition: opacity .4s ease; }

  /* ── active states, driven by HowItWorks.astro ──────────── */
  .clone-stack.cs-active-0 .cs-spine .spine,
  .clone-stack.cs-active-0 .cs-spine .tick { stroke: var(--accent); }
  .clone-stack.cs-active-0 .cs-spine .spine-seed { fill: var(--accent); }
  .clone-stack.cs-active-0 .cs-spine-pulse { opacity: 1; }

  .clone-stack.cs-active-1 .cs-base .hot { opacity: 1; }
  .clone-stack.cs-active-1 .cs-lead-base { opacity: 1; }

  .clone-stack.cs-active-2 .cs-plane polygon { stroke: var(--accent); }
  .clone-stack.cs-active-2 .p-top { fill: rgba(219, 231, 255, 0.85); }
  .clone-stack.cs-active-2 .cs-flow { opacity: 1; }
  .clone-stack.cs-active-2 .cs-lead-planes { opacity: 1; }

  @media (max-width: 900px) {
    .clone-stack { min-height: 340px; }
  }

  /* The drawing scales with its viewBox, so the labels are enlarged in user
     units to stay legible once the figure is only a phone wide. */
  @media (max-width: 760px) {
    .lead-label, .cs-val { font-size: 15px; }
    .clone-stack :global(.ill-tm) { font-size: 15px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hot, .cs-flow, .cs-spine-pulse, .cs-lead, .cs-plane polygon, .spine, .tick, .spine-seed {
      transition: none;
    }
    .cs-flow { opacity: 0; }
  }
</style>
