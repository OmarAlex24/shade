---
// Nav.astro — sticky, scroll-aware, mobile-accessible navigation.
import { REPO_URL, repoTree } from '../consts';

const links = [
  { label: 'How it works', href: '#how-it-works', spy: true },
  { label: 'Numbers', href: '#numbers', spy: true },
  { label: 'Lifecycle', href: '#lifecycle', spy: true },
  { label: 'Docs', href: repoTree('docs'), spy: false },
  { label: 'GitHub', href: REPO_URL, spy: false },
];
---

<header class="nav" id="nav-root" role="banner">
  <div class="container">
    <nav class="nav-inner" aria-label="Main">
      <a href="#top" class="nav-wordmark" aria-label="Shade, back to top">
        <span class="wm-mark" aria-hidden="true"></span>
        <span class="wm-text">Shade</span>
      </a>

      <ul class="nav-links" role="list">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              data-spy-link={link.spy ? '' : undefined}
              rel={link.spy ? undefined : 'noreferrer'}
            >{link.label}</a>
          </li>
        ))}
      </ul>

      <div class="nav-cta">
        <a href="#install" class="btn-primary">Install <span class="arrow">&#8594;</span></a>
      </div>

      <button
        class="nav-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-drawer"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </nav>
  </div>

  <div class="nav-drawer" id="nav-drawer" role="navigation" aria-label="Mobile menu">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    <a href="#install" class="btn-primary">Install</a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.78);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    transition:
      box-shadow 0.2s ease,
      transform 0.32s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s ease;
  }

  .nav.scrolled {
    box-shadow: 0 1px 12px rgba(10, 12, 18, 0.05);
    border-bottom-color: var(--border-strong);
  }

  /* Hide-on-scroll-down */
  .nav.nav-hidden { transform: translateY(-100%); }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: 2rem;
  }

  .nav-wordmark {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    flex-shrink: 0;
  }
  .nav-wordmark:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  /* Two offset squares: the immutable base and the clone that sits on it. */
  .wm-mark {
    position: relative;
    width: 15px;
    height: 15px;
    background: var(--accent);
    flex: none;
  }
  .wm-mark::after {
    content: '';
    position: absolute;
    left: 6px;
    top: 6px;
    width: 15px;
    height: 15px;
    border: 1.5px solid var(--ink);
  }

  .wm-text {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--ink);
    padding-left: 7px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
  }

  .nav-links a {
    position: relative;
    font-size: 0.9rem;
    color: var(--body);
    text-decoration: none;
    transition: color 0.18s;
    white-space: nowrap;
  }

  .nav-links a:hover,
  .nav-links a:focus-visible { color: var(--ink); }

  .nav-links a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* Scroll-spy active indicator */
  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s;
    opacity: 0;
  }

  .nav-links a[aria-current="true"] { color: var(--ink); }
  .nav-links a[aria-current="true"]::after { transform: scaleX(1); opacity: 1; }

  .nav-cta { display: flex; align-items: center; gap: 1rem; }

  /* Hamburger */
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .nav-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .nav-toggle span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--ink);
    transition: all 0.25s;
  }
  .nav-toggle.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .nav-toggle.open span:nth-child(2) { opacity: 0; }
  .nav-toggle.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  /* Mobile drawer */
  .nav-drawer {
    display: none;
    flex-direction: column;
    gap: 0;
    background: var(--bg);
    border-top: 1px solid var(--border);
  }
  .nav-drawer.open { display: flex; }
  .nav-drawer a {
    font-size: 1rem;
    color: var(--ink);
    text-decoration: none;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--border);
    transition: background 0.18s;
  }
  .nav-drawer a:hover,
  .nav-drawer a:focus-visible { background: var(--bg-soft); }
  .nav-drawer a:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .nav-drawer .btn-primary { margin: 1rem 1.5rem; justify-content: center; }

  @media (max-width: 860px) {
    .nav-links,
    .nav-cta { display: none; }
    .nav-toggle { display: flex; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav { transition: none; }
    .nav-links a::after { transition: none; }
  }
</style>

<script>
  import { onLenisReady } from '../scripts/lenis-instance';

  const nav = document.getElementById('nav-root');
  const toggle = nav?.querySelector<HTMLButtonElement>('.nav-toggle');
  const drawer = document.getElementById('nav-drawer');

  // ── Scrolled state (subtle shadow once you leave the very top) ──
  function onScrolledState(): void {
    if (!nav) return;
    if (window.scrollY > 10) nav.classList.add('scrolled');
    else nav.classList.remove('scrolled');
  }
  window.addEventListener('scroll', onScrolledState, { passive: true });
  onScrolledState();

  // ── Hide-on-scroll-down / show-on-scroll-up ──
  const VELOCITY_THRESHOLD = 0.15;
  const SCROLL_TOP_THRESHOLD = 80;

  function showNav(): void { nav?.classList.remove('nav-hidden'); }
  function hideNav(): void { nav?.classList.add('nav-hidden'); }

  // Lenis path — uses velocity/direction (no flash during momentum settle)
  onLenisReady((lenis) => {
    lenis.on('scroll', (l) => {
      if (!nav) return;
      const isMenuOpen = drawer?.classList.contains('open') ?? false;
      if (l.scroll < SCROLL_TOP_THRESHOLD || isMenuOpen) { showNav(); return; }
      if (Math.abs(l.velocity) < VELOCITY_THRESHOLD) return;
      if (l.direction === 1) hideNav();
      else if (l.direction === -1) showNav();
    });
  });

  // Native fallback (reduced-motion / Lenis not inited)
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReducedMotion) {
    const NATIVE_THRESHOLD = 4;
    let lastScrollY = window.scrollY;
    let ticking = false;
    const updateNativeHideNav = (): void => {
      if (!nav) return;
      const currentY = window.scrollY;
      const delta = currentY - lastScrollY;
      const isMenuOpen = drawer?.classList.contains('open') ?? false;
      if (currentY < SCROLL_TOP_THRESHOLD || isMenuOpen) showNav();
      else if (delta > NATIVE_THRESHOLD) hideNav();
      else if (delta < -NATIVE_THRESHOLD) showNav();
      lastScrollY = currentY;
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(updateNativeHideNav); }
    }, { passive: true });
  }

  // ── Mobile drawer ──
  function openDrawer(): void {
    if (!toggle || !drawer) return;
    drawer.classList.add('open');
    toggle.classList.add('open');
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', 'Close menu');
    showNav();
  }
  function closeDrawer(): void {
    if (!toggle || !drawer) return;
    drawer.classList.remove('open');
    toggle.classList.remove('open');
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Open menu');
  }
  toggle?.addEventListener('click', () => {
    if (drawer?.classList.contains('open')) closeDrawer();
    else openDrawer();
  });
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape' && drawer?.classList.contains('open')) {
      closeDrawer();
      toggle?.focus();
    }
  });
  drawer?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => closeDrawer());
  });

  // ── Scroll-spy ──
  const SPY_SECTIONS = ['#top', '#how-it-works', '#numbers', '#lifecycle'];
  const spyLinks = Array.from(nav?.querySelectorAll<HTMLAnchorElement>('[data-spy-link]') ?? []);

  function setActiveLink(href: string): void {
    spyLinks.forEach((link) => {
      if (link.getAttribute('href') === href) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
  }

  if (spyLinks.length > 0 && 'IntersectionObserver' in window) {
    const spyObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            if (id) setActiveLink(`#${id}`);
          }
        });
      },
      { rootMargin: '-45% 0px -50% 0px', threshold: 0 }
    );
    SPY_SECTIONS.forEach((selector) => {
      const el = document.querySelector(selector);
      if (el) spyObserver.observe(el);
    });
  }
</script>
