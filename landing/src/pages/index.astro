---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import CommandMarquee from '../components/CommandMarquee.astro';
import Problem from '../components/Problem.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Numbers from '../components/Numbers.astro';
import Lifecycle from '../components/Lifecycle.astro';
import Durability from '../components/Durability.astro';
import HostUsage from '../components/HostUsage.astro';
import Limitations from '../components/Limitations.astro';
import Install from '../components/Install.astro';
import Footer from '../components/Footer.astro';
---

<Base>
